<div class="scroll-hero" aria-hidden="true">
  <svg
    class="scroll-hero-art"
    viewBox="0 0 96 190"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      class="hero-web"
      d="M48 0V47"
      fill="none"
      stroke="#d7d0e6"
      stroke-opacity=".72"
      stroke-width="2"
    />
    <g class="hero-figure">
      <path
        d="M48 76c-8 0-13 6-13 14 0 7 5 12 13 12s13-5 13-12c0-8-5-14-13-14Z"
        fill="#252532"
        stroke="#a476ff"
        stroke-width="2"
      />
      <path d="m39 87 7-3-1 6-7 1Zm18 0-7-3 1 6 7 1Z" fill="#a9ff5b" />
      <path
        d="m39 103 9-3 9 3 6 24-15 9-15-9Z"
        fill="#343447"
        stroke="#a476ff"
        stroke-width="2"
        stroke-linejoin="round"
      />
      <path
        d="m39 107-9 10-9 3-3-4 9-8 7-11m23 10 9 10 9 3 3-4-9-8-7-11"
        fill="none"
        stroke="#c5c2d4"
        stroke-width="6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="m42 133-2 17-8 13 5 3 12-12 3-17m4-4 2 17 8 13-5 3-12-12-3-17"
        fill="none"
        stroke="#c5c2d4"
        stroke-width="6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M48 101v32m-6-21h12m-12 9h12"
        fill="none"
        stroke="#a9ff5b"
        stroke-opacity=".75"
        stroke-width="1.5"
      />
      <path
        d="M46 76c-5-3-7-8-5-13 2-4 7-6 10-9 2-2 2-5 1-7 7 3 10 10 7 16-2 5-7 7-9 13"
        fill="none"
        stroke="#c5c2d4"
        stroke-width="5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <circle cx="49" cy="50" r="3" fill="#a9ff5b" />
    </g>
  </svg>
</div>

<style>
  .scroll-hero {
    position: fixed;
    z-index: 40;
    top: 0;
    right: max(0.75rem, env(safe-area-inset-right));
    width: 5.5rem;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .scroll-hero.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-hero-art {
    display: block;
    width: 100%;
    overflow: visible;
    filter: drop-shadow(0 3px 8px #0009);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hero {
      transition: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>(".scroll-hero");
  const web = hero?.querySelector<SVGPathElement>(".hero-web");
  const figure = hero?.querySelector<SVGGElement>(".hero-figure");
  const maxDrop = 180;
  let rafId = 0;

  function updateHero() {
    const drop = Math.min(window.scrollY / 900, 1) * maxDrop;
    web?.setAttribute("d", `M48 0V${47 + drop}`);
    figure?.setAttribute("transform", `translate(0 ${drop})`);
    hero?.classList.toggle("is-visible", window.scrollY > 24);
    rafId = 0;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!rafId) {
        rafId = requestAnimationFrame(updateHero);
      }
    },
    { passive: true }
  );

  updateHero();
</script>
