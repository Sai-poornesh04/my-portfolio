---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:py-36 pb-14">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div class="w-full md:w-[60%] text-left space-y-5">
        <p class="text-[11px] md:text-xs uppercase tracking-[0.28em] text-[var(--white-icon)]">
          DevOps Engineer • Java • Spring Boot • Azure • AWS
        </p>

        <div class="space-y-4">
          <h1 class="text-[var(--white)] text-5xl sm:text-6xl md:text-7xl font-semibold leading-[0.9] tracking-[-0.07em]">
            Sai Poornesh
            <span class="block">Kavili</span>
          </h1>

          <div class="flex flex-wrap items-center gap-2 text-sm md:text-base text-[var(--white-icon)]">
            <span class="font-medium text-[var(--white)]">DevOps Engineer</span>
            <span>•</span>
            <span>Cognizant</span>
            <span>•</span>
            <span>1.5–2 years experience</span>
          </div>
        </div>

        <p class="max-w-2xl text-base md:text-xl text-[var(--white-icon)] leading-relaxed">
          I build and support reliable cloud-native systems with a focus on backend
          delivery, deployment automation, monitoring, and incident-aware operations.
        </p>

        <div class="flex flex-wrap justify-start gap-3 pt-2 md:pt-3">
          <a
            target="_blank"
            href="https://www.linkedin.com/in/sai-poornesh-kavili-0b4bab220/"
            class="inline-flex items-center justify-center rounded-full border border-[var(--sec)] bg-[var(--sec)]/10 px-5 py-2.5 text-sm font-medium text-[var(--white)] transition hover:bg-[var(--sec)]/20"
          >
            View LinkedIn
          </a>
          <a
            target="_blank"
            href="https://github.com/Sai-poornesh04"
            class="inline-flex items-center justify-center rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] px-5 py-2.5 text-sm font-medium text-[var(--white)] transition hover:bg-[var(--white-icon-tr)]"
          >
            GitHub
          </a>
        </div>

        <div class="flex flex-wrap gap-3 pt-2 md:pt-2">
          <span
            class="border border-[var(--white-icon-tr)] bg-[#1414149c] px-3 py-2 rounded-full text-xs md:text-sm text-[var(--white-icon)]"
            >Netherlands-based client project</span
          >
          <span
            class="border border-[var(--white-icon-tr)] bg-[#1414149c] px-3 py-2 rounded-full text-xs md:text-sm text-[var(--white-icon)]"
            >Onsite abroad experience</span
          >
        </div>
      </div>

      <div class="flex w-full justify-center md:w-[40%] md:justify-end">
        <div class="profile-photo-shell">
          <img
            src="/images/profile1.jpeg"
            alt="Sai Poornesh Kavili"
            class="profile-photo"
          />
        </div>
      </div>
    </div>

    <LogoWall />

    <div id="experience" class="grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-[var(--white-icon)]">
          Current role
        </p>
        <p class="mt-3 text-xl font-medium text-[var(--white)]">DevOps Engineer</p>
        <p class="mt-2 text-[var(--white-icon)]">Cognizant</p>
      </div>
      <div class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-[var(--white-icon)]">
          Experience
        </p>
        <p class="mt-3 text-xl font-medium text-[var(--white)]">1.5–2 years</p>
        <p class="mt-2 text-[var(--white-icon)]">Delivery and support in enterprise systems</p>
      </div>
      <div class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-[var(--white-icon)]">
          Client context
        </p>
        <p class="mt-3 text-xl font-medium text-[var(--white)]">Netherlands project</p>
        <p class="mt-2 text-[var(--white-icon)]">Onsite exposure abroad for a client delivery engagement</p>
      </div>
    </div>

    <div class="flex flex-col lg:flex-row items-center gap-8">
      <SkillsList client:load />
      <div
        class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16"
      >
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .profile-photo-shell {
    position: relative;
    display: flex;
    width: min(72vw, 280px);
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 2px;
    background: linear-gradient(135deg, rgba(164, 118, 255, 0.9), rgba(73, 255, 160, 0.8));
    box-shadow: 0 0 0 1px rgba(164, 118, 255, 0.45), 0 18px 44px rgba(113, 79, 164, 0.35);
    transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
    overflow: hidden;
  }

  .profile-photo-shell:hover {
    transform: scale(1.03);
    box-shadow: 0 0 0 1px rgba(164, 118, 255, 0.7), 0 20px 50px rgba(164, 118, 255, 0.45);
  }

  .profile-photo-shell::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.18), transparent 26%),
      linear-gradient(180deg, rgba(10, 10, 10, 0.18), rgba(10, 10, 10, 0.44));
    pointer-events: none;
  }

  .profile-photo {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    filter: saturate(0.9) contrast(1.08) brightness(0.96);
    background: #171717;
  }

  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }

  @media (max-width: 767px) {
    .profile-photo-shell {
      width: min(58vw, 180px);
      box-shadow: 0 0 0 1px rgba(164, 118, 255, 0.45), 0 12px 28px rgba(113, 79, 164, 0.3);
    }
  }
</style>
