---

interface Project {
  title: string;
  visual: string;
  link: string;
  status: string;
  summary: string;
  tags: string[];
  focus: string;
  cta: string;
  kind: "featured" | "placeholder";
}

const projects: Project[] = [
  {
    title: "Vishnu-Marketing",
    visual: "featured",
    link: "https://github.com/Sai-poornesh04",
    status: "Personal Project",
    summary:
      "A marketing web app focused on campaign orchestration, customer engagement, and business-facing workflows.",
    tags: ["Java", "Spring Boot", "Kotlin", "Angular", "Azure", "AWS"],
    focus: "Campaign workflows, customer engagement, deployment support",
    cta: "View project →",
    kind: "featured",
  },
  {
    title: "Project 2",
    visual: "placeholder",
    link: "#",
    status: "Placeholder",
    summary:
      "Placeholder project description for future work samples and technical deep dives.",
    tags: ["Java", "Spring Boot", "Azure DevOps"],
    focus: "Backend services and CI/CD delivery",
    cta: "Details coming soon",
    kind: "placeholder",
  },
  {
    title: "Project 3",
    visual: "placeholder",
    link: "#",
    status: "Placeholder",
    summary:
      "Placeholder project for additional platform, cloud, or application engineering work.",
    tags: ["Angular", "AWS", "Splunk", "Kotlin"],
    focus: "Platform reliability and application support",
    cta: "Details coming soon",
    kind: "placeholder",
  },
];
---

<section id="projects" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
        <h3 class="text-4xl md:text-5xl font-medium">Projects</h3>
      </div>
      <a
        target="_blank"
        href="https://github.com/Sai-poornesh04"
        class="inline-flex items-center justify-center gap-2 self-start rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] px-4 py-2.5 text-sm font-medium text-[var(--white)] transition hover:border-[var(--sec)] hover:bg-[var(--sec)]/10"
      >
        See all on GitHub
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-4"
        >
          <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
        </svg>
      </a>
    </div>

    <p class="mb-8 max-w-2xl text-sm text-[var(--white-icon)] md:text-base">
      A mix of personal builds and work I’m proud of — more added regularly.
    </p>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3 items-stretch">
      {
        projects.map((project) => {
          const hasLink = project.link !== "#";
          const isPlaceholder = project.kind === "placeholder";

          if (hasLink) {
            return (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="project-card group block h-full rounded-[22px] border border-[var(--white-icon-tr)] bg-[#1414149c] p-4 text-left transition-all duration-200 ease-out hover:-translate-y-1 hover:border-[var(--sec)]/70 hover:shadow-[0_18px_42px_rgba(109,74,180,0.18)]"
              >
                <div
                  class:list={[
                    "project-visual",
                    project.visual === "featured" ? "project-visual--featured" : "project-visual--placeholder",
                  ]}
                >
                  {project.visual === "featured" ? (
                    <>
                      <div class="project-visual__glow"></div>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 64 64"
                        fill="none"
                        class="project-visual__icon"
                        aria-hidden="true"
                      >
                        <path d="M14 42.5V21.5C14 18.4624 16.4624 16 19.5 16H44.5C47.5376 16 50 18.4624 50 21.5V42.5C50 45.5376 47.5376 48 44.5 48H19.5C16.4624 48 14 45.5376 14 42.5Z" stroke="currentColor" stroke-width="2.5"/>
                        <path d="M24 26L29 31L36 24L44 32" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M38 24H44V30" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <div class="project-visual__label">Vishnu</div>
                    </>
                  ) : (
                    <>
                      <div class="project-visual__pattern"></div>
                      <span class="project-visual__tag">Coming soon</span>
                    </>
                  )}
                </div>

                <div class="mt-4 flex items-start justify-between gap-3">
                  <h4 class="text-2xl font-semibold text-[var(--white)] leading-tight">
                    {project.title}
                  </h4>
                  <span class="shrink-0 rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.12em] text-[var(--white-icon)]">
                    {project.status}
                  </span>
                </div>

                <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-[var(--white-icon)]">
                  {project.summary}
                </p>

                <div class="mt-4 flex flex-wrap gap-2">
                  {project.tags.map((tech) => (
                    <span class="rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] px-2.5 py-1 text-[10px] md:text-[11px] text-[var(--white)]">
                      {tech}
                    </span>
                  ))}
                </div>

                <div class="mt-auto pt-4 mt-5 border-t border-[#ffffff10]">
                  <div class="flex items-center justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <p class="text-[10px] uppercase tracking-[0.18em] text-[var(--white-icon)]">
                        Focus
                      </p>
                      <p class="mt-1 text-sm leading-relaxed text-[var(--white)]">
                        {project.focus}
                      </p>
                    </div>
                    <span class="inline-flex shrink-0 items-center gap-2 rounded-full border border-[var(--sec)]/35 bg-[var(--sec)]/10 px-3 py-1.5 text-xs font-medium text-[var(--white)] transition hover:bg-[var(--sec)]/15">
                      {project.cta}
                    </span>
                  </div>
                </div>
              </a>
            );
          }

          return (
            <article class="project-card group flex h-full flex-col rounded-[22px] border border-[var(--white-icon-tr)] bg-[#1414149c] p-4 text-left transition-all duration-200 ease-out hover:-translate-y-1 hover:border-[var(--sec)]/70 hover:shadow-[0_18px_42px_rgba(109,74,180,0.18)]">
              <div
                class:list={[
                  "project-visual",
                  project.visual === "featured" ? "project-visual--featured" : "project-visual--placeholder",
                ]}
              >
                {project.visual === "featured" ? (
                  <>
                    <div class="project-visual__glow"></div>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 64 64"
                      fill="none"
                      class="project-visual__icon"
                      aria-hidden="true"
                    >
                      <path d="M14 42.5V21.5C14 18.4624 16.4624 16 19.5 16H44.5C47.5376 16 50 18.4624 50 21.5V42.5C50 45.5376 47.5376 48 44.5 48H19.5C16.4624 48 14 45.5376 14 42.5Z" stroke="currentColor" stroke-width="2.5"/>
                      <path d="M24 26L29 31L36 24L44 32" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M38 24H44V30" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <div class="project-visual__label">Vishnu</div>
                  </>
                ) : (
                  <>
                    <div class="project-visual__pattern"></div>
                    <span class="project-visual__tag">Coming soon</span>
                  </>
                )}
              </div>

              <div class="mt-4 flex items-start justify-between gap-3">
                <h4 class="text-2xl font-semibold text-[var(--white)] leading-tight">
                  {project.title}
                </h4>
                <span class="shrink-0 rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.12em] text-[var(--white-icon)]">
                  {project.status}
                </span>
              </div>

              <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-[var(--white-icon)]">
                {project.summary}
              </p>

              <div class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tech) => (
                  <span class="rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] px-2.5 py-1 text-[10px] md:text-[11px] text-[var(--white)]">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="mt-auto pt-4 mt-5 border-t border-[#ffffff10]">
                <div class="flex items-center justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <p class="text-[10px] uppercase tracking-[0.18em] text-[var(--white-icon)]">
                      Focus
                    </p>
                    <p class="mt-1 text-sm leading-relaxed text-[var(--white)]">
                      {project.focus}
                    </p>
                  </div>
                  <span class="inline-flex shrink-0 items-center gap-2 rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] px-3 py-1.5 text-xs font-medium text-[var(--white-icon)]">
                    {project.cta}
                  </span>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="mt-8 flex justify-center">
      <a
        target="_blank"
        href="https://github.com/Sai-poornesh04"
        class="inline-flex items-center justify-center gap-2 rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] px-6 py-3 text-sm md:text-base font-medium text-[var(--white)] transition hover:bg-[var(--white-icon-tr)] hover:border-[var(--sec)]"
      >
        View more on GitHub
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-4"
        >
          <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style is:global>
  .project-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(164, 118, 255, 0.7);
    box-shadow: 0 18px 42px rgba(109, 74, 180, 0.18);
  }

  .project-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 176px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
  }

  .project-visual--featured {
    background: linear-gradient(135deg, rgba(164, 118, 255, 0.28), rgba(164, 118, 255, 0.08));
    color: rgba(223, 223, 223, 0.9);
  }

  .project-visual--placeholder {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.08));
  }

  .project-visual--placeholder::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.06) 0,
        rgba(255, 255, 255, 0.06) 1px,
        transparent 1px,
        transparent 12px
      ),
      linear-gradient(
        45deg,
        rgba(164, 118, 255, 0.08) 0,
        rgba(164, 118, 255, 0.08) 1px,
        transparent 1px,
        transparent 12px
      );
    background-size: 18px 18px;
    opacity: 0.85;
  }

  .project-visual__glow {
    position: absolute;
    inset: 18% 18% auto auto;
    width: 180px;
    height: 180px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(164, 118, 255, 0.42), transparent 70%);
    filter: blur(18px);
  }

  .project-visual__icon {
    position: relative;
    z-index: 1;
    width: 80px;
    height: 80px;
    opacity: 0.75;
    color: rgba(164, 118, 255, 0.9);
  }

  .project-visual__label {
    position: absolute;
    bottom: 18px;
    left: 18px;
    z-index: 1;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(223, 223, 223, 0.9);
  }

  .project-visual__pattern {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.06) 0,
        rgba(255, 255, 255, 0.06) 1px,
        transparent 1px,
        transparent 12px
      ),
      linear-gradient(
        45deg,
        rgba(164, 118, 255, 0.08) 0,
        rgba(164, 118, 255, 0.08) 1px,
        transparent 1px,
        transparent 12px
      );
    background-size: 18px 18px;
    opacity: 0.9;
  }

  .project-visual__tag {
    position: absolute;
    right: 12px;
    top: 12px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(16, 16, 16, 0.75);
    padding: 0.28rem 0.6rem;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(223, 223, 223, 0.82);
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .project-visual {
      min-height: 160px;
    }
  }
</style>
