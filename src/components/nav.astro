---
interface NavItem {
  label: string;
  mobileLabel: string;
  href: string;
  icon: string;
}

const navItems: NavItem[] = [
  {
    label: "Home",
    mobileLabel: "Home",
    href: "#home",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"></path></svg>`,
  },
  {
    label: "Experience",
    mobileLabel: "Exp.",
    href: "#experience",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M20 6H16V4C16 2.9 15.1 2 14 2H10C8.9 2 8 2.9 8 4V6H4C2.9 6 2 6.9 2 8V19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V8C22 6.9 21.1 6 20 6ZM10 4H14V6H10V4ZM4 19V8H20V19H4ZM11 11H13V13H11V11ZM7 11H9V13H7V11ZM15 11H17V13H15V11Z"></path></svg>`,
  },
  {
    label: "Projects",
    mobileLabel: "Work",
    href: "#projects",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z"></path></svg>`,
  },
  {
    label: "Blogs",
    mobileLabel: "Blog",
    href: "/blogs",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm0 2v14h14V5H5Zm3 3h8v2H8V8Zm0 4h8v2H8v-2Zm0 4h5v2H8v-2Z"></path></svg>`,
  },
  {
    label: "Contact",
    mobileLabel: "Contact",
    href: "#contact",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"></path></svg>`,
  },
];
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    class="fixed left-1/2 top-3 -translate-x-1/2 z-[100] bg-[var(--background)] border border-1 border-transparent backdrop-blur-xl transition-all duration-500 ease-in-out md:top-6 w-[94%] md:w-[80%]"
  >
    <div class="container mx-auto flex justify-center items-center p-3">
      <ul
        class="flex w-full justify-between gap-6 md:justify-center"
      >
        {
          navItems.map((item) => (
            <li class="flex-1 md:flex-none">
              <a
                href={
                  item.href.startsWith("#") && Astro.url.pathname !== "/"
                    ? `/${item.href}`
                    : item.href
                }
                aria-current={Astro.url.pathname === item.href ? "page" : undefined}
                class="flex flex-col items-center gap-1 text-[var(--white-icon)] transition-colors text-xs md:text-base relative group"
              >
                <div class="absolute -left-6 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full transition-all duration-300 scale-0 opacity-0 bg-[#A9FF5B] nav-indicator hidden md:block" />
                <span class="md:hidden flex items-center justify-center w-6 h-6">
                  <fragment set:html={item.icon} />
                </span>
                <span class="hidden md:inline-block">{item.label}</span>
                <span class="md:hidden text-[10px]">{item.mobileLabel}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</div>
<style>
  nav {
    transform: translateX(-50%);
    background-color: var(--background);
    transition:
      background-color 0.3s ease,
      border-radius 0.3s ease,
      border-color 0.3s ease;
  }

  nav.scrolling {
    background-color: var(--component-bg);
    border-color: #ffffff10;
    border-radius: 9999px;
  }

  nav a.active .nav-indicator,
  nav a[aria-current="page"] .nav-indicator {
    transform: translateY(-50%) scale(1);
    opacity: 1;
  }

  nav a.active,
  nav a[aria-current="page"] {
    color: white !important;
  }

  @media (max-width: 767px) {
    nav {
      transform: translateX(-50%);
      top: auto;
      bottom: max(0.75rem, env(safe-area-inset-bottom));
      left: 50%;
      padding: 0.1rem;
      border-color: #ffffff10;
    }

    nav:not(.scrolling) {
      border-radius: 9999px;
    }

    body {
      padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");
  const navLinks = nav?.querySelectorAll<HTMLAnchorElement>("a[href^='#']");
  const sectionTargets = Array.from(navLinks ?? [])
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((target): target is HTMLElement => target !== null);
  const maxScroll = 1000;
  let rafId: number | null = null;

  function setActiveNavLink(id: string) {
    navLinks?.forEach((link) => {
      link.classList.toggle("active", link.hash === `#${id}`);
    });
  }

  function updateActiveNav() {
    if (sectionTargets.length === 0) return;

    const activationLine = window.scrollY + window.innerHeight * 0.35;
    let activeTarget = sectionTargets[0];

    for (const target of sectionTargets) {
      if (target.getBoundingClientRect().top + window.scrollY > activationLine) {
        break;
      }
      activeTarget = target;
    }

    if (
      window.innerHeight + window.scrollY >=
      document.documentElement.scrollHeight - 1
    ) {
      activeTarget = sectionTargets[sectionTargets.length - 1];
    }

    setActiveNavLink(activeTarget.id);
  }

  function updateNav() {
    const isMobile = window.innerWidth < 768;
    const startWidth = window.innerWidth * (isMobile ? 0.94 : 0.8);
    const endWidth = Math.min(
      528,
      window.innerWidth * (isMobile ? 0.78 : 0.8)
    );

    if (window.scrollY > 0) {
      nav?.classList.add("scrolling");

      const scrollProgress = Math.min(window.scrollY / maxScroll, 1);
      const easeProgress = 1 - Math.pow(1 - scrollProgress, 4);
      const currentWidth = startWidth - (startWidth - endWidth) * easeProgress;
      nav?.style.setProperty("width", `${currentWidth}px`);
    } else {
      nav?.classList.remove("scrolling");
      nav?.style.setProperty("width", `${startWidth}px`);
    }
    updateActiveNav();
    rafId = null;
  }

  updateNav();

  window.addEventListener(
    "scroll",
    () => {
      if (!rafId) {
        rafId = requestAnimationFrame(updateNav);
      }
    },
    { passive: true }
  );
  window.addEventListener("resize", updateNav);

  navLinks?.forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      const targetId = anchor.hash.slice(1);
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        setActiveNavLink(targetId);
        targetElement.scrollIntoView({
          behavior: "smooth",
        });
      }
    });
  });
</script>
