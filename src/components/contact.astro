    color: var(--white);
  }

  .stat-card--wide {
    grid-column: span 1;
  }

  .contact-actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    justify-self: stretch;
  }

  .social-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
