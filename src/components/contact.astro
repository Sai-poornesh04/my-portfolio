    text-decoration: none;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }

  .social-button:hover,
  .social-button:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(164, 118, 255, 0.8);
    box-shadow: 0 18px 38px rgba(122, 80, 198, 0.18);
    background: rgba(24, 24, 28, 0.9);
  }

  .social-button:focus-visible {
    outline: 2px solid rgba(164, 118, 255, 0.9);
    outline-offset: 3px;
  }

  .social-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1rem;
    font-weight: 500;
  }

  .social-copy svg {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 180ms ease;
  }

  .social-button:hover .social-copy svg,
  .social-button:focus-visible .social-copy svg {
    transform: translateX(3px) scale(1.08);
  }

  .social-arrow {
    font-size: 1.5rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.82);
    transition: transform 180ms ease;
  }

  .social-button:hover .social-arrow,
  .social-button:focus-visible .social-arrow {
    transform: translateX(5px);
  }

  .contact-ambient {
    position: absolute;
    inset: 12% auto auto 10%;
    width: min(32rem, 56vw);
    height: min(22rem, 38vw);
    border-radius: 40% 60% 58% 42% / 40% 42% 58% 60%;
    background: radial-gradient(circle at 30% 35%, rgba(164, 118, 255, 0.28), transparent 42%),
      radial-gradient(circle at 68% 70%, rgba(66, 217, 165, 0.16), transparent 42%),
      linear-gradient(135deg, rgba(164, 118, 255, 0.06), rgba(66, 217, 165, 0.04));
    filter: blur(20px);
    opacity: 0.92;
    transform: translate3d(0, 0, 0) scale(1);
    transition: transform 180ms ease-out;
    pointer-events: none;
  }

  .contact-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(circle at center, black 28%, transparent 82%);
    opacity: 0.45;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .contact-section {
      padding: 4rem 0 3rem;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      padding: 0 1rem;
    }

    .stat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-actions {
      gap: 0.7rem;
    }

    .social-button {
      width: 100%;
    }

    .contact-ambient {
      inset: 8% auto auto 5%;
      width: 70vw;
      height: 18rem;
      opacity: 0.5;
    }
  }

  @media (max-width: 480px) {
    .stat-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-section,
    .stat-card,
    .social-button,
    .social-button .social-copy svg,
    .social-button .social-arrow,
    .contact-ambient {
      transition: none !important;
      animation: none !important;
    }
