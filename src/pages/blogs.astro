---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
---

<Layout title="Blogs">
  <Nav />
  <main class="mx-auto min-h-screen max-w-5xl pt-32 text-[var(--white)] md:pt-40">
    <p class="mb-2 text-sm uppercase tracking-[0.2em] text-[var(--white-icon)]">
      Writing
    </p>
    <h1 class="text-4xl font-semibold tracking-tight md:text-6xl">Blogs</h1>
    <p class="mt-4 max-w-xl leading-relaxed text-[var(--white-icon)]">
      No posts published yet. Check back soon.
    </p>
  </main>
</Layout>
